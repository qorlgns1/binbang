#!/bin/sh
set -e

# 같은 파일에 "스테이징한 변경"과 "스테이징하지 않은 변경"이 함께 있으면 중단한다.
# 아래에서 파일 단위로 다시 add 하기 때문에, 그대로 두면 커밋할 의도가 없던
# 변경까지 함께 커밋된다. (git add 는 hunk 단위가 아니라 파일 전체를 담는다)
staged_list=$(mktemp)
unstaged_list=$(mktemp)
trap 'rm -f "$staged_list" "$unstaged_list"' EXIT

git diff --cached --name-only --diff-filter=d | sort > "$staged_list"
git diff --name-only --diff-filter=d | sort > "$unstaged_list"
overlap=$(comm -12 "$staged_list" "$unstaged_list")

if [ -n "$overlap" ]; then
  echo "커밋 중단: 아래 파일에 스테이징하지 않은 변경이 함께 있습니다." >&2
  printf '%s\n' "$overlap" | sed 's/^/  /' >&2
  echo "" >&2
  echo "포맷 적용 후 파일 전체가 다시 add 되어 의도하지 않은 변경이 섞입니다." >&2
  echo "해당 변경을 스테이징하거나 stash 한 뒤 다시 커밋하세요." >&2
  exit 1
fi

pnpm format

# 삭제된 경로는 add 대상에서 제외한다(--diff-filter=d).
# 삭제된 파일을 git add 하면 pathspec 오류로 커밋 전체가 막힌다.
# NUL 구분(-z / -0)으로 넘겨 따옴표·공백이 든 파일명도 안전하게 처리한다.
git diff --cached --name-only --diff-filter=d -z | xargs -0 git add --
